# Copied to server/.env by setup.sh. Edit, then: sudo systemctl restart pluckreel

# Requests (video lookups + download starts) per visitor IP per window
RATE_LIMIT=10
RATE_WINDOW_SECONDS=60

# Simultaneous downloads: overall, and per visitor. Each one runs yt-dlp (+ ffmpeg).
# A 2 vCPU / 8 GB VPS handles ~4-6 comfortably; bandwidth usually runs out first.
MAX_DOWNLOADS=4
MAX_DOWNLOADS_PER_IP=1

# Simultaneous video lookups
MAX_INFO_LOOKUPS=4
